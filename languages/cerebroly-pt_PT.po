msgid "These settings control how documents are retrieved from the knowledge base when a user sends a query. They affect the relevance and number of documents included in the context."
msgstr "Ces paramètres contrôlent la manière dont les documents sont récupérés de la base de connaissances lorsqu'un utilisateur envoie une requête. Ils affectent la pertinence et le nombre de documents inclus dans le contexte."

#: admin/views/rag-config.php:261
msgid "Documents to Retrieve"
msgstr "Documents à récupérer"

#: admin/views/rag-config.php:265
msgid "Number of most relevant fragments to include in the context. More fragments provide more information but may dilute relevance."
msgstr "Nombre de fragments les plus pertinents à inclure dans le contexte. Plus de fragments fournissent plus d'informations mais peuvent diluer la pertinence."

#: admin/views/rag-config.php:270
msgid "Similarity Threshold"
msgstr "Seuil de similarité"

#: admin/views/rag-config.php:277
