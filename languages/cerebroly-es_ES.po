msgid "Enrich"
msgstr "Enriquecer"

#: admin/views/rag-config.php:102
msgid "Enhances the model's context with these documents for better responses."
msgstr "Mejora el contexto del modelo con estos documentos para obtener mejores respuestas."

#: admin/views/rag-config.php:106
msgid "Generate"
msgstr "Generar"

#: admin/views/rag-config.php:107
